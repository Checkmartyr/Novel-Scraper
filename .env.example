# ==============================================================================
# Novel Scraping Agent Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini LLM Configuration
# ------------------------------------------------------------------------------
# Google Gemini API key required for Agent classification, DOM analysis, and review loop.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini model identifier. Recommended: gemini-2.5-flash (fast, cost-effective),
# gemini-2.5-pro (highest reasoning depth), or gemini-3.5-flash-lite.
# Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Obscura Anti-Detect Headless Browser Engine
# ------------------------------------------------------------------------------
# Explicit path to Obscura binary. Leave blank to automatically download the
# latest stealth release from GitHub (h4ckf0r0day/obscura) into ./bin/obscura.exe.
OBSCURA_BIN_PATH=

# Timeout in seconds for page fetching via Obscura CLI / Playwright CDP. Default: 30
NAVIGATION_TIMEOUT=30

# Navigation wait condition for Playwright: networkidle, domcontentloaded, load, commit.
# Default: networkidle
WAIT_UNTIL=networkidle

# GitHub repository for auto-downloading Obscura releases.
# Default: h4ckf0r0day/obscura
OBSCURA_GITHUB_REPO=h4ckf0r0day/obscura


# ------------------------------------------------------------------------------
# 3. Polite Batch Scraper Settings
# ------------------------------------------------------------------------------
# Number of concurrent workers downloading chapters (clamped between 1 and 10).
# Default: 3
DEFAULT_CONCURRENCY=3

# Polite jitter delay range in seconds applied before each chapter fetch.
# Default: 0.5 to 1.5
MIN_DELAY_SECONDS=0.5
MAX_DELAY_SECONDS=1.5

# ------------------------------------------------------------------------------
# 4. Storage, Markdown & Romanization Settings
# ------------------------------------------------------------------------------
# Target root directory for saving downloaded novels.
# Default: ./novels
OUTPUT_DIR=./novels

# Whether to include YAML frontmatter metadata at top of chapter .md files.
# Set to 'false' (default) for clean raw markdown (# Title \n\n Content).
# Set to 'true' to include YAML frontmatter (novel, chapter_number, source_url, etc.).
INCLUDE_FRONTMATTER=false

# Whether to romanize novel folder names (Japanese->Romaji, Chinese->Pinyin, Korean->Romaja, Russian->Latin).
# Set to 'true' (default) to create clean ASCII directory names (e.g., novels/GuiMiZhiZhu).
# Set to 'false' to preserve original native script in directory names.
ROMANIZE_FOLDER=true

# ------------------------------------------------------------------------------
# 5. Actor-Critic Quality Control Observer & Review Loop
# ------------------------------------------------------------------------------
# Maximum review & refinement loop iterations between ChapterAnalyzer and ExtractionObserver.
# Default: 3
MAX_REVIEW_ITERATIONS=3

# Minimum quality threshold score (0.0 to 1.0) required for observer approval.
# Default: 0.85
MIN_QUALITY_SCORE=0.85
